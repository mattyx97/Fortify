{
  "name": "nuxt-full-stack-starter",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run infra:dev-up && nuxt dev",
    "build": "nuxt build --dotenv .env",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "cd ./server/lib/database && drizzle-kit generate",
    "db:migrate": "cd ./server/lib/database && drizzle-kit migrate",
    "db:push": "cd ./server/lib/database && drizzle-kit push",
    "db:studio": "cd ./server/lib/database && drizzle-kit studio",
    "ai:studio": "mastra studio -p 4111 --server-port 3000 --server-api-prefix /api/_mastra",
    "infra:dev-up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "infra:dev-down": "docker compose -f docker-compose.dev.yml down",
    "infra:dev-reset": "docker compose -f docker-compose.dev.yml down -v --remove-orphans --rmi local",
    "puppeteer:install-chrome": "rebrowser-puppeteer browsers install chrome",
    "grab-cookies": "tsx scripts/grab-cookies.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1010.0",
    "@better-auth/drizzle-adapter": "^1.5.5",
    "@mastra/core": "^1.17.0",
    "@mastra/memory": "^1.10.0",
    "@mastra/observability": "^1.5.1",
    "@mastra/pg": "^1.8.3",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.6.0",
    "@tanstack/vue-query": "^5.95.2",
    "@vueuse/nuxt": "^14.2.1",
    "better-auth": "^1.5.6",
    "cheerio": "^1.2.0",
    "consola": "^3.4.2",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^1.0.0-beta.19",
    "flydrive": "^2.1.0",
    "glob-url": "^0.1.1",
    "nodemailer": "^8.0.4",
    "nuxt": "^4.4.2",
    "nuxt-authorization": "^0.3.5",
    "nuxt-email-renderer": "^2.6.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "stripe": "^21.0.1",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "whoiser": "2.0.0-beta.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@mastra/hono": "^1.3.0",
    "@mastra/server": "^1.17.0",
    "@nuxt/devtools-kit": "^3.2.4",
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^1.0.0-beta.19",
    "eslint": "^10.1.0",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "eslint-plugin-format": "^2.0.1",
    "mastra": "^1.3.15",
    "rebrowser-puppeteer": "^24.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
